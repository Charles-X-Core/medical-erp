# Credenciales de despliegue / pruebas.
#
# Copiar este archivo a "deploy/.env" (NO se versiona, esta en .gitignore) y
# completarlo con los valores reales. Uso:
#
#   set -a && . deploy/.env && set +a
#   bash deploy/test-signos-walkin.sh
#
# Las credenciales REALES de produccion (base de datos, JWT, correo) NO estan
# en el repo: viven en /opt/medical-erp/application.properties dentro del VPS.

# Password de MySQL del VPS (se usa con mysql -u root -p"$MYSQL_PASSWORD")
MYSQL_PASSWORD=

# Password SSH de root del VPS, para pscp/plink
VPS_PASSWORD=

# Password de un usuario de la app, para pruebas de API
APP_USER_EMAIL=
APP_USER_PASSWORD=
